{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "ultracite": {
      "command": ["pnpm", "dlx", "ultracite", "fix", "$FILE"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".json", ".css", ".md"]
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://localhost:9223"
      ]
    }
  }
}
