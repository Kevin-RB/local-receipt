    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.0.0",
    "ai": "^7.0.52",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "inngest": "^4.15.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pg": "^8.16.0",
    "postcss": "^8.5.25",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
