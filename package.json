{
  "name": "receipt-app",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first receipt AI analyser — single Next.js app with services in Docker compose.",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 0.0.0.0",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx ./lib/db/seed.ts"
  },
  "dependencies": {
