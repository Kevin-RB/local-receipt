{
  "name": "receipt-app",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first receipt AI analyser — single Next.js app with services in Docker compose.",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 0.0.0.0",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx ./lib/db/seed.ts",
    "db:fixture": "tsx --env-file-if-exists=.env.local ./scripts/db-fixture.ts",
    "categorize:backfill": "tsx --env-file-if-exists=.env.local ./scripts/backfill-categorization.ts",
    "eval:chat": "tsx --env-file-if-exists=.env.local ./evals/chat/run.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@ai-sdk/react": "^4.0.160",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@hookform/resolvers": "^5.9.2",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "ai": "^7.0.156",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "inngest": "^4.26.1",
    "loading-dev": "^0.3.6",
    "lucide-react": "^1.64.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "react": "19.2.4",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.91.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "streamdown": "^2.7.1",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.6",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^1.0.59",
    "@inngest/test": "^1.0.0",
    "@shadcn/lint": "^0.1.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "ultracite": "7.12.0",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.15.0",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
