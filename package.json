    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "husky": "^9.1.7",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.77.0",
    "tsx": "^4.23.7",
